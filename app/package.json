{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@noble/hashes": "^2.2.0",
    "@op-engineering/op-sqlite": "^17.1.2",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~57.0.8",
    "expo-build-properties": "^57.0.7",
    "expo-camera": "~57.0.3",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-secure-store": "^57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "^5.1.1"
  },
  "devDependencies": {
    "@signalapp/libsignal-client": "^0.99.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:relay": "jest relaySmoke --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "jest": {
    "projects": [
      {
        "displayName": "expo",
        "preset": "jest-expo",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "\\.node\\.test\\.tsx?$"
        ],
        "moduleNameMapper": {
          "^node-gyp-build$": "<rootDir>/jest/node-gyp-build.js"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@noble/.*|@signalapp/.*)"
        ]
      },
      {
        "displayName": "node",
        "testEnvironment": "node",
        "testMatch": [
          "**/*.node.test.ts"
        ],
        "transform": {
          "^.+\\.(js|ts|tsx)$": [
            "babel-jest",
            {
              "presets": [
                "@babel/preset-typescript"
              ],
              "plugins": [
                "./jest/import-meta-shim.js",
                "@babel/plugin-transform-export-namespace-from",
                "@babel/plugin-transform-modules-commonjs"
              ]
            }
          ]
        },
        "moduleNameMapper": {
          "^node-gyp-build$": "<rootDir>/jest/node-gyp-build.js"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!@noble/.*|@signalapp/.*)"
        ]
      }
    ]
  },
  "private": true
}
